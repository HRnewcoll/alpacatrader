# Alpaca API Credentials
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Trading Mode: paper or live
TRADING_MODE=paper

# Risk Management
MAX_PORTFOLIO_RISK_PCT=2.0
MAX_DAILY_LOSS_PCT=5.0
MAX_POSITION_SIZE_PCT=10.0
MAX_OPEN_POSITIONS=10
STOP_LOSS_PCT=2.0
TAKE_PROFIT_PCT=4.0
# Set > 0 to enable trailing stop (replaces fixed stop-loss when price rises)
TRAILING_STOP_PCT=0.0
# Set > 0 to block buys when bid-ask spread exceeds this % (slippage guard)
MAX_BID_ASK_SPREAD_PCT=0.0

# Strategy Parameters - Mean Reversion
MR_LOOKBACK_PERIOD=20
MR_STD_THRESHOLD=2.0

# Strategy Parameters - Momentum
MOM_RSI_PERIOD=14
MOM_MACD_FAST=12
MOM_MACD_SLOW=26
MOM_MACD_SIGNAL=9
MOM_RSI_OVERBOUGHT=70
MOM_RSI_OVERSOLD=30

# Strategy Parameters - Pairs Trading
PAIRS_LOOKBACK=60
PAIRS_Z_SCORE_ENTRY=2.0
PAIRS_Z_SCORE_EXIT=0.5

# Watchlist (comma-separated)
WATCHLIST=AAPL,MSFT,GOOGL,AMZN,TSLA,META,NVDA,JPM,BAC,WMT

# Pairs for pairs trading (comma-separated pairs, colon between symbols)
PAIRS_LIST=AAPL:MSFT,JPM:BAC

# Alerts
ALERT_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Telegram Bot alerting (set both to enable)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# Slack incoming webhook URL (set to enable)
SLACK_WEBHOOK_URL=

# Database
DB_PATH=trading.db

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs

# -----------------------------------------------------------------------
# Automation features (new)
# -----------------------------------------------------------------------

# Market-hours scheduler
USE_MARKET_HOURS=true
SCHEDULER_WARMUP_MINUTES=5
SCHEDULER_CLOSEOUT_MINUTES=5

# News sentiment filter
NEWS_ENABLED=true
NEWS_LOOKBACK_HOURS=24
NEWS_NEGATIVE_THRESHOLD=-0.3
NEWS_POSITIVE_THRESHOLD=0.2

# Dynamic watchlist screener
SCREENER_ENABLED=true
SCREENER_TOP_N=20
SCREENER_MIN_AVG_VOLUME=500000
SCREENER_LOOKBACK_DAYS=10
# Optional broader universe (defaults to WATCHLIST if blank)
SCREENER_UNIVERSE=

# Portfolio rebalancer
REBALANCER_ENABLED=true
REBALANCER_CHECK_INTERVAL_HOURS=168

# Walk-forward optimizer
OPTIMIZER_LOOKBACK_MONTHS=6
# Set to true to automatically overwrite .env with best params
OPTIMIZER_WRITE_ENV=false

# Web dashboard
DASHBOARD_ENABLED=false
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080

# -----------------------------------------------------------------------
# New features
# -----------------------------------------------------------------------

# Breakout strategy
BREAKOUT_LOOKBACK_DAYS=20
BREAKOUT_VOLUME_FACTOR=1.5

# VWAP reversion strategy
VWAP_STD_THRESHOLD=1.5
VWAP_LOOKBACK_DAYS=20

# Multi-timeframe confirmation (suppresses BUY when daily trend is bearish)
MTF_ENABLED=false
MTF_TREND_LOOKBACK_DAYS=20
