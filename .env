# =============================================================================
# ALPACA TRADING CONFIGURATION - PAPER TRADING SETUP
# =============================================================================
# Get your keys from: https://app.alpaca.markets/paper/dashboard/overview
# =============================================================================

# Alpaca API Credentials (REQUIRED - Replace with YOUR keys)
ALPACA_API_KEY=PK_YOUR_PAPER_API_KEY_HERE
ALPACA_SECRET_KEY=YOUR_PAPER_SECRET_KEY_HERE

# Paper Trading URL (Default - Don't change for paper trading)
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# For LIVE trading (real money), change to:
# ALPACA_BASE_URL=https://api.alpaca.markets
# TRADING_MODE=live

# Trading Mode: "paper" or "live"
TRADING_MODE=paper

# =============================================================================
# RISK MANAGEMENT SETTINGS
# =============================================================================
MAX_PORTFOLIO_RISK_PCT=2.0        # Max risk per trade (% of portfolio)
MAX_DAILY_LOSS_PCT=5.0            # Stop trading if daily loss exceeds this
MAX_POSITION_SIZE_PCT=10.0        # Max position size (% of portfolio)
MAX_OPEN_POSITIONS=10             # Maximum concurrent positions
STOP_LOSS_PCT=2.0                 # Automatic stop-loss percentage
TAKE_PROFIT_PCT=4.0               # Automatic take-profit percentage

# =============================================================================
# STRATEGY PARAMETERS
# =============================================================================
# Mean Reversion Strategy
MR_LOOKBACK_PERIOD=20
MR_STD_THRESHOLD=2.0

# Momentum Strategy
MOM_RSI_PERIOD=14
MOM_MACD_FAST=12
MOM_MACD_SLOW=26
MOM_MACD_SIGNAL=9
MOM_RSI_OVERBOUGHT=70
MOM_RSI_OVERSOLD=30

# Pairs Trading Strategy
PAIRS_LOOKBACK=60
PAIRS_Z_SCORE_ENTRY=2.0
PAIRS_Z_SCORE_EXIT=0.5

# Volatility Breakout Strategy
VB_ATR_PERIOD=14
VB_LOOKBACK_PERIOD=20
VB_BREAKOUT_MULTIPLIER=2.0
VB_VOLUME_CONFIRMATION=true

# =============================================================================
# WATCHLIST & PAIRS
# =============================================================================
WATCHLIST=AAPL,MSFT,GOOGL,AMZN,TSLA,META,NVDA,JPM,BAC,WMT,SPY,QQQ
PAIRS_LIST=AAPL:MSFT,JPM:BAC,GOOGL:META

# =============================================================================
# ALERT CONFIGURATION (Optional)
# =============================================================================
# Email Alerts
ALERT_EMAIL=your_email@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password

# Telegram Alerts (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord Webhook (Optional)
DISCORD_WEBHOOK_URL=

# =============================================================================
# DATABASE & LOGGING
# =============================================================================
DB_PATH=alpaca_trader.db
LOG_LEVEL=INFO
LOG_DIR=logs

# =============================================================================
# ADVANCED FEATURES
# =============================================================================
# ML Signal Enhancement
ML_ENHANCEMENT_ENABLED=true
ML_MODEL_PATH=ml_models/signal_model.pkl

# Market Regime Detection
REGIME_DETECTION_ENABLED=true

# Order Execution Algorithm: "market", "twap", "vwap", "iceberg"
ORDER_EXECUTION_ALGO=market

# =============================================================================
